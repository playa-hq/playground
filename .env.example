# Copy to .env and fill in. .env is gitignored — never commit real keys.

# fal.ai — https://fal.ai/dashboard/keys
# Used by the `genmedia` CLI (it also stores this via `genmedia setup`).
FAL_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Aikido local scanner — https://app.aikido.dev/settings/integrations/localscan
# Token is shown once at creation. Format: AIK_CI_xxx
AIKIDO_API_KEY=

# Aikido scan target metadata (used by scripts/scan.sh)
AIKIDO_REPO_NAME=playa
