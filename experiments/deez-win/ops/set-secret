#!/usr/bin/env bash
# Set a runtime secret locally and on the VPS without it ever touching a
# shell history, an agent transcript, or git.
#
#   ./ops/set-secret CALA_API_KEY            # prompts silently, writes ../../.env and the VPS env
#   ./ops/set-secret FAL_KEY --local         # only ../../.env
#
# Run it from your own terminal: it needs a TTY for the hidden prompt.
set -euo pipefail
cd "$(dirname "$0")/../../.."

NAME="${1:-}"
case "$NAME" in
  CALA_API_KEY|FAL_KEY) ;;
  *) echo "usage: $0 CALA_API_KEY|FAL_KEY [--local]"; exit 1 ;;
esac
shift

HOST="${DEPLOY_HOST:-root@46.101.104.158}"
REMOTE_ENV=/opt/deez-win/env

[ -t 0 ] || { echo "needs a terminal (the prompt is hidden)"; exit 1; }
read -rsp "$NAME: " KEY; echo
[ -n "$KEY" ] || { echo "empty key, nothing done"; exit 1; }

# Local .env: replace or append the line.
touch .env
if grep -q "^$NAME=" .env; then
  sed -i "s|^$NAME=.*|$NAME=$KEY|" .env
else
  printf '%s=%s\n' "$NAME" "$KEY" >> .env
fi
echo "local  .env updated"
[ "${1:-}" = "--local" ] && exit 0

# Remote: same replace-or-append, then restart so the running binary sees it.
ssh "$HOST" "NAME='$NAME' KEY='$KEY' bash -s" <<'REMOTE'
set -euo pipefail
touch /opt/deez-win/env
if grep -q "^$NAME=" /opt/deez-win/env; then
  sed -i "s|^$NAME=.*|$NAME=$KEY|" /opt/deez-win/env
else
  printf '%s=%s\n' "$NAME" "$KEY" >> /opt/deez-win/env
fi
chown www-data:www-data /opt/deez-win/env && chmod 600 /opt/deez-win/env
systemctl restart deez-win
sleep 1
systemctl is-active deez-win
journalctl -u deez-win -n 4 --no-pager | grep -i "cala\|fal" || true
REMOTE
echo "remote $HOST:$REMOTE_ENV updated and service restarted"
